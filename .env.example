# Copy to .env before running. Phase 1 defaults target the local docker-compose stack.

PORT=4000
NODE_ENV=development
# Origin allowed to call the API / open a socket (the dev frontend).
CORS_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/pcb_circuit_agent

# S3-compatible object storage.
# Phase 1: local MinIO (see docker-compose.yml). To point at real AWS S3 later,
# leave S3_ENDPOINT empty, set S3_FORCE_PATH_STYLE=false, and supply real keys.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=pcb-artifacts
S3_ACCESS_KEY_ID=pcbagent
S3_SECRET_ACCESS_KEY=pcbagent_dev_secret
S3_FORCE_PATH_STYLE=true

# Max accepted Hardware Agent upload size.
MAX_UPLOAD_BYTES=2097152
