# Copy to .env at the repo root and fill in. Never commit the filled-in file.
# `.env` lives at the repo root and is shared by docker-compose and the server.
#
# Only MONGO_URI and S3_BUCKET are strictly required — the server throws on
# startup without them. Everything else has a working default or degrades
# explicitly.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=2097152

# ---------------------------------------------------------------------------
# MongoDB  (REQUIRED)
# ---------------------------------------------------------------------------
# docker compose brings this up on :27017
MONGO_URI=mongodb://localhost:27017/pcb_circuit_agent

# ---------------------------------------------------------------------------
# Object storage  (S3_BUCKET REQUIRED)
# ---------------------------------------------------------------------------
# Dev uses a local MinIO container on 9100/9101 — NOT the MinIO defaults of
# 9000/9001, which an unrelated project on the original machine already held
# (DECISIONS.md D-002). Switching to real AWS S3 is a config change only:
# clear S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false, and drop the two keys so
# the AWS SDK's default credential chain is used instead.
# These defaults MATCH docker-compose.yml's fallbacks, so the dev stack works
# whether or not .env exists. Changing them here means changing them for MinIO
# too — compose reads the same variables.
S3_BUCKET=pcb-artifacts

# --- local MinIO ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=pcbagent
S3_SECRET_ACCESS_KEY=pcbagent_dev_secret

# --- real AWS S3 instead: leave the two keys UNSET ---
# Unset credentials are deliberate, not an omission. The SDK then falls back to
# its default chain (~/.aws/credentials, SSO, or an IAM role), which is how the
# eu-north-1 round-trip test was run — no credentials in this repo, ever.
# S3_ENDPOINT=
# S3_REGION=eu-north-1
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# LLM providers — OPTIONAL, and only for two narrow jobs
# ---------------------------------------------------------------------------
# Nothing in the compile path needs a model. These keys are used by:
#   1. Phase 6 datasheet pin extraction (scripts/run-pin-batch.js)
#   2. Phase 8 request interpretation  (scripts/run-modification.js)
# With no keys set, the pipeline still runs end-to-end: pins stay unresolved
# rather than invented, and modifications must be passed as --instruction JSON.
#
# Extractor A (Gemini)     : GEMINI_API_KEY -> GEMINI_API_KEY_2
# Extractor B (non-Gemini) : Groq_API_KEY -> Groq_API_KEY_2 -> Ollama Cloud
# Within each extractor the numbered keys are a rotation for quota exhaustion,
# not different providers.
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Extractor B dispatches on the KEY PREFIX, not the variable name (D-047):
#   gsk_... -> Groq        xai_... -> x.ai
# The variable is read under several spellings for historical reasons, so a key
# in any of them works. Prefer Groq_API_KEY for new setups.
Groq_API_KEY=
Groq_API_KEY_2=

# Ollama Cloud is a HOSTED API needing a key — not a local daemon (D-058).
ollama_API_KEY=
